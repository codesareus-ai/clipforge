# Copy to .env and fill in. NEVER commit .env.
APP_NAME=ClipForge
ENV=dev

# Storage (Cloudflare R2 / S3) — needed for Instagram pull-from-URL
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
PUBLIC_BASE_URL=https://cdn.example.com

# Transcription
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
USE_DIARIZATION=false
HF_TOKEN=

# LLM ranking
RANK_LLM_PROVIDER=openai
RANK_LLM_MODEL=gpt-4o-mini
RANK_LLM_API_KEY=
# Base URL for OpenAI-compatible proxies (OpenRouter free tier, etc.).
# Leave empty for api.openai.com. For OpenRouter use:
#   RANK_LLM_BASE_URL=https://openrouter.ai/api/v1
#   RANK_LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free   (or any :free model)
USE_VISION_RANK=false

# Render
REMOTION_PROJECT_DIR=../frontend
FFMPEG_BIN=ffmpeg
OUTPUT_DIR=./outputs

# Platform OAuth (client ids/secrets only — never user tokens)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
IG_APP_ID=
IG_APP_SECRET=
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# Vault
TOKEN_ENCRYPTION_KEY=

# Auth (self-contained token signer — generate a random 32+ char string)
TOKEN_SECRET=

DATABASE_URL=sqlite:///./clipforge.db
REDIS_URL=redis://localhost:6379/0
